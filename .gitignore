.evidence/template
.svelte-kit
build
node_modules
.DS_Store
.ipynb_checkpoints/
*-checkpoint.ipynb

# installed by scripts/apply-notebook-core.mjs from the vendored core —
# vendor/evidence/packages/evidence/notebook/python/evidence.py is the original
/evidence.py
static/data
*.options.yaml
.vscode/settings.json
.env
.evidence/meta

# derived — synced from the dbt project by scripts/sync-dbt.sh
sources/dbt_semantic/*.duckdb

# graphify local state (machine-specific paths, caches, intermediates)
graphify-out/cache/
graphify-out/.graphify_*

# graphify build metadata: manifest.json records a float mtime per file and
# cost.json records one run's token spend, so both are rewritten on every
# rebuild with no reviewable change. graph.json, graph.html and GRAPH_REPORT.md
# stay tracked — they are the deliverable, and scripts/graphify-lineage.py
# regenerates them deterministically.
graphify-out/manifest.json
graphify-out/cost.json

# dated snapshot directories from earlier graphify runs
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# scratch datasets written by tests/bench-openzl.mjs — hundreds of MB, regenerable
.bench/

# rill/up.sh stages the Evidence parquet here so read_parquet() resolves
/rill/data

#logs in the root of the repo are generated by the rill CLI and are not needed for source control
logs/

# deploy/env is generated from deploy/env.example and is per-machine
/deploy/env

# python bytecode
__pycache__/
*.pyc
