# Copy to deploy/env on the server, and to .env at the repo root for local dev.
#
#   cp deploy/env.example deploy/env

# --- where the site is served from -----------------------------------------
# deploy/build.sh writes releases under $SERVE_ROOT/releases/<stamp> and flips
# $SERVE_ROOT/current to the newest one. Caddy only ever reads `current`.
SERVE_ROOT=/srv/evidence

# --- the build's heap ------------------------------------------------------
# Node sizes its default heap from visible RAM, so on a 2 GB box it picks ~1 GB
# and a cold build dies with "Ineffective mark-compacts near heap limit" before
# swap is ever touched. Setting this explicitly is what lets swap be reached.
#
# Measured cold, on this project:
#
#   cap 1792 -> OOM
#   cap 2048 -> 2.82 GiB peak RSS, succeeds
#   cap 2560 -> 2.74 GiB peak RSS, succeeds
#   cap 3072 -> 3.36 GiB peak RSS, succeeds
#
# So the floor is between 1792 and 2048, and there is a plateau around 2.8 GiB
# either side of 2048 — the extra 512 MB of headroom at 2560 buys slightly
# cheaper GC, not a larger footprint. 3072 is where V8 genuinely starts
# spreading out, and on a box this size that is half a gigabyte of extra paging
# for nothing. Anywhere in 2048–2560 is the right setting.
EVIDENCE_BUILD_HEAP_MB=2048

# --- Cube ------------------------------------------------------------------
# Leave VITE_CUBE_API_URL unset on the server: the page calls /cubejs-api on its
# own origin and Caddy proxies it to 127.0.0.1:4000.
#
# Set it ONLY for local dev, where Evidence is on :3000 and Cube on :4000 with
# no proxy in between:
# VITE_CUBE_API_URL=http://localhost:4000

# Cube signs its API tokens with this and refuses to start without it once
# CUBEJS_DEV_MODE=false — which evidence-cube.service sets. Leave it unset and
# the unit restart-loops and /noodle-cube renders nothing, with the reason only
# in the journal. Generate one per box:
#
#   openssl rand -hex 32
#
# It is not a login for readers. Cube is bound to loopback and reached only
# through the /cubejs-api proxy, and deploy/cube/cube.js overrides checkAuth so
# the browser sends no token at all; the secret exists because the server
# insists on having one. It lives here rather than in the unit file or in
# cube.js because both of those are world-readable and committed respectively.
CUBEJS_API_SECRET=replace-me-with-openssl-rand-hex-32

# --- ADBC fixtures ---------------------------------------------------------
# Started by deploy/build.sh for the seconds `evidence sources` needs them, then
# stopped. Override if your distro names them differently.
PG_SVC=postgresql.service
CH_SVC=clickhouse-server.service
