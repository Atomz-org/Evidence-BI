# Evidence BI — the whole serve plane.
#
# The site is static (adapter-static) and every query runs in the browser on
# duckdb-wasm, so this server executes no SQL and holds no query state. Its RSS
# is ~20 MB regardless of how many people are reading dashboards.
#
# Two jobs only:
#   1. hand over precompressed files from the live build
#   2. reverse-proxy /cubejs-api to Cube on loopback, so the browser reaches the
#      semantic layer same-origin and Cube never binds a public port
#
# Install: /etc/caddy/Caddyfile   ·   validate: caddy validate --config <this>

# The two knobs below let this same file serve the production release and a
# local ./build, so what you test is the config that ships rather than a
# simplified stand-in:
#
#   caddy run --config deploy/Caddyfile                       the server
#   EVIDENCE_ROOT=$PWD/build EVIDENCE_LISTEN=:8080 \
#     caddy run --config deploy/Caddyfile                     locally
#
# (or just: deploy/serve-local.sh)

{
	# No admin API — it is another listener and another 8 MB we do not need.
	admin off

	# The build is regenerated by deploy/build.sh; Caddy only ever reads it.
	auto_https off
}

{$EVIDENCE_LISTEN::80} {
	root * {$EVIDENCE_ROOT:/srv/evidence/current}

	encode zstd gzip

	# --- Cube, same-origin -------------------------------------------------
	# /noodle-cube fetches /cubejs-api/v1/{meta,load,sql} relative to the page.
	# Without this the browser would resolve those against its own machine.
	handle /cubejs-api/* {
		reverse_proxy {$CUBE_UPSTREAM:127.0.0.1:4000} {
			# Cube answers 200 {"error":"Continue wait"} while a query warms and
			# the client polls; do not let the proxy cut that short.
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# --- Static site -------------------------------------------------------
	handle {
		# deploy/precompress.sh writes .br and .gz siblings. Serving those costs
		# no CPU and no memory: the two duckdb-wasm binaries are 71 MB on disk
		# and ~15 MB brotli'd, and Caddy sendfile()s them straight out.
		file_server {
			precompressed br zstd gzip
			index index.html
		}
	}

	# Hashed immutable assets: cache hard, so a returning reader never re-fetches
	# the 33/38 MB wasm pair.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Parquet is regenerated by every build and must not be pinned.
	@data path /data/*
	header @data Cache-Control "public, max-age=300, must-revalidate"

	# Deliberately NOT setting COOP/COEP. Evidence ships the non-threaded
	# duckdb-wasm build, which does not need cross-origin isolation, and
	# `require-corp` would block every cross-origin asset that arrives without a
	# CORP header — a self-inflicted outage for no gain.
	header {
		X-Content-Type-Options nosniff
		-Server
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
