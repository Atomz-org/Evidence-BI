{
  "name": "my-evidence-project",
  "version": "0.0.1",
  "scripts": {
    "postinstall": "node scripts/apply-notebook-core.mjs && node scripts/build-rill-model.mjs",
    "notebooks": "node scripts/apply-notebook-core.mjs",
    "build": "evidence build",
    "build:strict": "evidence build:strict",
    "dev": "evidence dev --open /",
    "test": "evidence build",
    "sources": "evidence sources",
    "sources:strict": "evidence sources --strict",
    "preview": "evidence preview",
    "cube:up": "docker compose -f cube/docker-compose.yml up -d",
    "cube:down": "docker compose -f cube/docker-compose.yml down",
    "test:noodle": "node tests/t-noodle.mjs",
    "test:dashboard": "node tests/t-dashboard.mjs",
    "test:studio": "node tests/t-studio-ui.mjs",
    "test:notebook": "node tests/t-serialize.mjs && node tests/t-compile.mjs",
    "test:cube": "node tests/t-cube-tz.mjs && node tests/t-cube.mjs && node tests/t-cubesql.mjs",
    "test:cube:ui": "node tests/t-cube-ui.mjs",
    "test:adbc": "node tests/t-adbc.mjs",
    "adbc:drivers": "for d in duckdb postgresql clickhouse snowflake bigquery; do npx --yes @columnar-tech/dbc install $d; done",
    "bench:layout": "node tests/bench-layout.mjs",
    "bench:openzl": "node tests/bench-openzl.mjs",
    "test:gallery": "node tests/t-gallery-ui.mjs",
    "test:livequery": "node tests/t-livequery-ui.mjs",
    "test:screen": "node tests/t-screen.mjs",
    "test:notebook:ui": "node tests/t-notebook-ui.mjs",
    "rill:model": "node scripts/build-rill-model.mjs",
    "rill:up": "./rill/up.sh",
    "test:rill": "node tests/t-rill.mjs",
    "test:rill:ui": "node tests/t-rill-ui.mjs",
    "test:canvas": "node tests/t-canvas.mjs",
    "test:canvas:ui": "node tests/t-canvas-ui.mjs",
    "test:flint": "node tests/t-flint.mjs",
    "test:flint:ui": "node tests/t-flint-ui.mjs",
    "dashboard:audit": "node scripts/dashboard-audit.mjs"
  },
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=18.0.0"
  },
  "type": "module",
  "dependencies": {
    "@evidence-dev/bigquery": "^2.0.12",
    "@evidence-dev/connector-gsheets": "^1.1.0",
    "@evidence-dev/core-components": "^5.4.2",
    "@evidence-dev/csv": "^1.0.16",
    "@evidence-dev/databricks": "^1.0.10",
    "@evidence-dev/duckdb": "^2.0.1",
    "@evidence-dev/evidence": "^40.1.8",
    "@evidence-dev/motherduck": "^1.0.6",
    "@evidence-dev/mssql": "^1.1.4",
    "@evidence-dev/mysql": "^1.1.6",
    "@evidence-dev/postgres": "^1.0.10",
    "@evidence-dev/snowflake": "^1.2.4",
    "@evidence-dev/source-javascript": "^0.0.3",
    "@evidence-dev/sqlite": "^2.0.9",
    "@evidence-dev/trino": "^1.0.11",
    "caniuse-lite": "^1.0.30001809",
    "evidence-connector-adbc": "file:connectors/adbc",
    "flint-chart": "^0.5.0"
  },
  "overrides": {
    "jsonwebtoken": "9.0.0",
    "trim@<0.0.3": ">0.0.3",
    "sqlite3": "5.1.5",
    "axios": "^1.7.4"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ]
}
